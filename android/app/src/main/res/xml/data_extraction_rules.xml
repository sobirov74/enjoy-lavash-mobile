<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device-to-device transfer rules.
  Nothing is backed up: the session lives in flutter_secure_storage, whose
  encryption keys stay in the device keystore and cannot be restored, so a
  restored copy would be unreadable. A fresh install simply signs in again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
